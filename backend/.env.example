# Public API configuration
CORS_ORIGINS=https://sirius-assistant.fr,https://www.sirius-assistant.fr
SIRIUS_PUBLIC_ORIGINS=https://sirius-assistant.fr
SIRIUS_AUTH_SECRET=

# Stripe - set these only in the Render environment, never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# New Stripe Price IDs: EUR 69 / 135 / 269 one-time, EUR 32 recurring monthly.
# Old price environment names are not used for new checkouts.
STRIPE_PRICE_STANDARD_69=
STRIPE_PRICE_PRO_135=
STRIPE_PRICE_LIFETIME_269=
STRIPE_PRICE_MONTHLY_32=
# Coupon: EUR 22 off the EUR 32 monthly price, duration=once, no product restriction.
STRIPE_COUPON_MONTHLY_FIRST_10=
# The 15-day account trial has no card; Stripe subscriptions start with immediate payment.
STRIPE_BILLING_PORTAL_CONFIGURATION=
STRIPE_BILLING_PORTAL_CONFIGURATION=

# Optional AI and integrations
# Conversation rapide prioritaire ; Groq reste le repli et la transcription.
CEREBRAS_API_KEY=
GROQ_API_KEY=
K3_API_KEY=
# Voix Android : Chirp Aoede en priorite, Gemini en secours. Cles serveur uniquement.
GOOGLE_TTS_API_KEY=
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede
# Mettre a 1 uniquement pour privilegier Gemini au lieu de Chirp.
GEMINI_TTS_PRIMARY=0
SERP_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Telephonie Vapi facultative : un compte SIRIUS et une ligne dedies.
# Aucun appel reel sans configuration et confirmation explicite ARIANE.
SIRIUS_VAPI_ENABLED=0
VAPI_PRIVATE_KEY=
VAPI_ORG_ID=
SIRIUS_VAPI_OWNER_USER_ID=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_CREDENTIAL_ID=
# HTTPS public vers /api/ariane/phone/webhook ; secret aleatoire >= 32 caracteres.
SIRIUS_VAPI_WEBHOOK_URL=
SIRIUS_VAPI_WEBHOOK_SECRET=
# Destinataires autorises, E.164, separes par des virgules. Vide = aucun sortant.
SIRIUS_VAPI_ALLOWED_NUMBERS=

# WhatsApp Cloud API Meta : une ligne professionnelle partagee, utilisateurs lies par preuve.
SIRIUS_WHATSAPP_ENABLED=0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Choisir explicitement une version Graph actuellement supportee par votre application Meta.
META_GRAPH_VERSION=

# OAuth Google existant : enregistrer cette URI exacte dans Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Notifications Workspace opt-in, ne sont pas actives par la simple presence des variables.
SIRIUS_CALENDAR_PUSH_URL=
SIRIUS_GMAIL_PUSH_AUDIENCE=
SIRIUS_GMAIL_PUSH_SERVICE_ACCOUNT=
SIRIUS_GMAIL_PUBSUB_TOPIC=
SIRIUS_GMAIL_PUBSUB_SUBSCRIPTION=