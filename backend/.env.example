# Public API configuration
CORS_ORIGINS=https://sirius-assistant.fr,https://www.sirius-assistant.fr
SIRIUS_PUBLIC_ORIGINS=https://sirius-assistant.fr
SIRIUS_AUTH_SECRET=

# Stripe - set these only in the Render environment, never commit real values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# New Stripe Price IDs: EUR 69 / 135 / 269 one-time, EUR 32 recurring monthly.
# Old price environment names are not used for new checkouts.
STRIPE_PRICE_STANDARD_69=
STRIPE_PRICE_PRO_135=
STRIPE_PRICE_LIFETIME_269=
STRIPE_PRICE_MONTHLY_32=
# Coupon: EUR 22 off the EUR 32 monthly price, duration=once, no product restriction.
STRIPE_COUPON_MONTHLY_FIRST_10=
# The 15-day account trial has no card; Stripe subscriptions start with immediate payment.
STRIPE_BILLING_PORTAL_CONFIGURATION=
STRIPE_BILLING_PORTAL_CONFIGURATION=

# Optional AI and integrations
# Conversation rapide prioritaire ; Groq reste le repli et la transcription.
CEREBRAS_API_KEY=
GROQ_API_KEY=
K3_API_KEY=
# Scan des etiquettes HACCP : photo transmise a OpenAI, cle serveur uniquement.
OPENAI_API_KEY=
# Voix Android : Chirp Aoede en priorite, Gemini en secours. Cles serveur uniquement.
GOOGLE_TTS_API_KEY=
GEMINI_TTS_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Aoede
# Mettre a 1 uniquement pour privilegier Gemini au lieu de Chirp.
GEMINI_TTS_PRIMARY=0
SERP_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Telephonie Vapi facultative : un compte SIRIUS et une ligne dedies.
# Aucun appel reel sans configuration et confirmation explicite ARIANE.
SIRIUS_VAPI_ENABLED=0
VAPI_PRIVATE_KEY=
VAPI_ORG_ID=
SIRIUS_VAPI_OWNER_USER_ID=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_CREDENTIAL_ID=
# HTTPS public vers /api/ariane/phone/webhook ; secret aleatoire >= 32 caracteres.
SIRIUS_VAPI_WEBHOOK_URL=
SIRIUS_VAPI_WEBHOOK_SECRET=
# Destinataires autorises, E.164, separes par des virgules. Vide = aucun sortant.
SIRIUS_VAPI_ALLOWED_NUMBERS=

# WhatsApp Cloud API Meta : une ligne professionnelle partagee, utilisateurs lies par preuve.
SIRIUS_WHATSAPP_ENABLED=0
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Choisir explicitement une version Graph actuellement supportee par votre application Meta.
META_GRAPH_VERSION=

# OAuth Google existant : enregistrer cette URI exacte dans Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Notifications Workspace opt-in, ne sont pas actives par la simple presence des variables.
SIRIUS_CALENDAR_PUSH_URL=
SIRIUS_GMAIL_PUSH_AUDIENCE=
SIRIUS_GMAIL_PUSH_SERVICE_ACCOUNT=
SIRIUS_GMAIL_PUBSUB_TOPIC=
SIRIUS_GMAIL_PUBSUB_SUBSCRIPTION=

# Alexa : deux Skills et deux clients OAuth independants, desactives sans configuration.
# Origine HTTPS publique partagee par l'application et /api (pas de / final).
SIRIUS_ALEXA_PUBLIC_ORIGIN=
SIRIUS_ALEXA_CLIENT_ID=
# Secrets aleatoires distincts >= 32 caracteres, backend uniquement.
SIRIUS_ALEXA_CLIENT_SECRET=
# URI exactes fournies par la console Amazon, separees par des virgules.
SIRIUS_ALEXA_REDIRECT_URIS=
SIRIUS_ALEXA_HOME_CLIENT_ID=
SIRIUS_ALEXA_HOME_CLIENT_SECRET=
SIRIUS_ALEXA_HOME_REDIRECT_URIS=

# Smart Life / Tuya Cloud : ne pas activer avant verification des liaisons.
SIRIUS_TUYA_ENABLED=0
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
# eu, eu-west, us, us-east, cn, in, sg ; verifier le centre de donnees du compte.
TUYA_REGION=
# JSON gere par l'operateur : {"id-compte-sirius":"uid-smart-life-verifie"}
# Jamais de mot de passe Smart Life ; aucun utilisateur ne choisit lui-meme son UID Tuya.
SIRIUS_TUYA_USER_BINDINGS={}

# Verification du locuteur (biometrie sensible), option serveur DESACTIVEE par defaut.
# Installer explicitement : pip install -r requirements-voice-identity.txt et ffmpeg.
# Modele recommande : wespeaker_en_voxceleb_resnet34_LM.onnx, 256 dimensions.
# Distribution officielle sherpa-onnx (inclut les metadonnees du frontend acoustique) :
# https://github.com/k2-fsa/sherpa-onnx/releases/tag/speaker-recongition-models
# Fichier : https://github.com/k2-fsa/sherpa-onnx/releases/download/speaker-recongition-models/wespeaker_en_voxceleb_resnet34_LM.onnx
# SHA256 du fichier sherpa officiel verifie le 2026-10-23 :
# e9848563da86f263117134dfd7ad63c92355b37de492b55e325400c9d9c39012
# Smoke natif sherpa-onnx 2.0.0 effectue : sortie 256 dimensions finies normalisables.
# Signal synthetique uniquement : ceci ne valide PAS la precision biometrie/TV.
# Smoke parole publique reel aussi effectue, LibriSpeech dev-clean (CC-BY-4.0),
# Panayotov et al. ICASSP 2015, https://www.openslr.org/12 :
# references 2277-149896-0000/0001/0002, meme locuteur tenu a part 2277-149896-0005,
# autre locuteur 2035-147960-0005. Cinq embeddings 256D finis.
# Cosinus references : 0.851150 / 0.859390 / 0.834996 ; centroide vs meme locuteur :
# 0.895115 ; vs autre : 0.360959. Echantillon minuscule anglais propre, PAS calibration.
# Un seuil 0.85 rejetterait deja une paire de references legitimes dans ce smoke.
# Aucun seuil recommande ni garantie FAR/TV : calibrer enrollment ET verification sur
# voix francaises, vrais microphones, bruit, TV et replays avant activation operateur.
# Provenance / attribution : WeSpeaker, Wang et al., ICASSP 2023, VoxCeleb2 Dev.
# Poids : CC-BY-4.0 (PAS la licence Apache du code) :
# https://huggingface.co/Wespeaker/wespeaker-voxceleb-resnet34-LM/blob/main/README.md
# Conversion officielle, metadonnees et pipeline :
# https://github.com/k2-fsa/sherpa-onnx/blob/master/scripts/wespeaker/run.sh
# https://github.com/k2-fsa/sherpa-onnx/blob/master/scripts/wespeaker/add_meta_data.py
# Controle independant : l'ONNX SOURCE sans metadonnees sur HuggingFace a pour SHA256
# 7bb2f06e9df17cdf1ef14ee8a15ab08ed28e8d0ef5054ee135741560df2ec068
# Ce hash n'est PAS celui du fichier sherpa : ne pas le copier dans MODEL_SHA256.
# Telecharger manuellement depuis la distribution officielle, verifier sa provenance,
# conserver une copie immuable approuvee et calculer son SHA256 (Get-FileHash -Algorithm SHA256).
# Renseigner le chemin ABSOLU local et ce hash approuve : aucun telechargement automatique.
# Exiger un compte authentifie et le consentement explicite lors de /enroll.
# 3 a 5 extraits distincts coherents, seul et sans TV, 3-15 s, max 3 Mio chacun.
# Verification d'un enonce : 3-20 s. Plus court => verified=false, insufficient_audio.
# Ce refus ne demande pas de fermer le micro ; attendre un nouvel enonce assez long.
# Audio seulement en RAM (y compris multipart et ffmpeg) ; seul le centroide est conserve
# dans le docstore utilisateur runtime_paths, jamais les enregistrements.
# DELETE /api/voice-identity/profile revoque le profil ; l'export exclut le vecteur sensible.
# Suppression disponible meme modele absent/desactive. enrolled indique le profil conserve ;
# modele modifie => ready=false, needs_reenrollment=true, jamais de reutilisation du vecteur.
# Le score cosinus n'est PAS une probabilite. Aucun seuil n'est pre-valide pour le francais,
# les microphones reels ou la TV : choisir explicitement 0.75..0.99 apres essais positifs/
# negatifs, faux rejets/faux accords, puis activer. Aucun seuil par defaut ni succes simule.
# Ce n'est ni une authentification forte ni une protection anti-rejeu/synthese vocale.
# 1 inference CPU/thread par processus, delai dur 30 s (60 s enrollment), 20 verifications/
# minute/compte et 2 enrollments/minute ; dimensionner les workers a la capacite CPU.
# Modele absent, mauvais hash, dependance absente ou panne => ready=false / verified=false.
SIRIUS_VOICE_IDENTITY_ENABLED=0
SIRIUS_VOICE_IDENTITY_MODEL_PATH=
SIRIUS_VOICE_IDENTITY_MODEL_SHA256=
SIRIUS_VOICE_IDENTITY_THRESHOLD=
# Chemin executable ffmpeg facultatif si deja dans PATH (pas d'arguments shell).
SIRIUS_VOICE_IDENTITY_FFMPEG=ffmpeg