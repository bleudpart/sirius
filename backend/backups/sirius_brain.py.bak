async def doc_narrative(sujet, data, keys=None):
    keys = keys or {}
    k3_key = (keys.get("k3") or keys.get("groq")) or ENV_K3_KEY
    extract = (data.get("wikipedia") or {}).get("extrait") or ""
    fallback = f"{sujet} — extrait documentaire :\n{extract[:700]}" if extract else f"Je n'ai pas assez de données documentaires sur {sujet}."
    if not k3_key:
        return fallback
    try:
        client = k3_client(k3_key)
        msgs = []
        for h in (data.get("history") or [])[-8:]:
            if isinstance(h, dict) and h.get("role") in ("user", "assistant") and h.get("content"):
                msgs.append({"role": h["role"], "content": str(h["content"])[:1000]})
        msgs.append({"role": "user", "content": f"Sujet du documentaire : {sujet} - Données : {json.dumps(data, ensure_ascii=False)}"})
        resp = await client.chat.completions.create(
            model=K3_MODEL,
            messages=msgs,
            max_tokens=600,
        )
        return resp.choices[0].message.content.strip()
    except Exception:
        return fallback


# ==========================================
# BOUCLE PRINCIPALE D'EXÉCUTION (ASK_SIRIUS)
# ==========================================
async def ask_sirius(prompt, history=None, profile=None, memory=None, mode="normal", keys=None, mood=None):
    """
    Cerveau central et unique de SIRIUS.
    Combine : K3 (analyse lourde et raisonnement) + SerpAPI (recherche web optionnelle) + Groq (formulation rapide).
    """
    keys = keys or {}
    k3_key = keys.get("k3") or ENV_K3_KEY
    serp_key = keys.get("serp") or ENV_SERP_KEY

    # 1. Vérification de la nécessité d'une recherche web
    web_snippets = ""
    if needs_web_search(prompt):
        logger.info(f"[CERVEAU] Recherche web déclenchée pour : '{prompt[:50]}'")
        web_snippets = await serp_search(prompt, serp_key)

    # 2. Construction du contexte et des messages pour l'IA
    sys_prompt = build_system_prompt(profile=profile, memory=memory, mode=mode, mood=mood)
    
    messages = [{"role": "system", "content": sys_prompt}]
    
    if history and isinstance(history, list):
        for h in history[-8:]:
            if isinstance(h, dict) and h.get("role") and h.get("content"):
                messages.append({"role": h["role"], "content": h["content"]})

    user_content = prompt
    if web_snippets:
        user_content += f"\n\nRÉSULTATS DE RECHERCHE WEB EN TEMPS RÉEL :\n{web_snippets}"

    messages.append({"role": "user", "content": user_content})

    # 3. Appel au modèle principal (Kimi K3) pour l'analyse profonde
    if not k3_key:
        return {
            "reponse": "Erreur critique : Aucune clé API Kimi K3 ou Groq n'est configurée dans le système.",
            "memoire": [],
            "popups": []
        }

    try:
        raw_analysis = await _k3_answer(messages, k3_key)
    except Exception as e:
        logger.error(f"[CERVEAU] Erreur critique K3: {repr(e)}")
        return {
            "reponse": "Erreur de communication avec le cortex central de SIRIUS.",
            "memoire": [],
            "popups": []
        }

    # 4. Analyse et structuration de la réponse brute
    answer, memories, popups = _parse_structured(raw_analysis)

    # Si aucun pop-up n'a été généré mais qu'on a des sources web riches, on en crée un automatiquement via Groq
    if not popups and web_snippets and len(web_snippets) > 200:
        auto_popup_content = await _groq_popup(prompt, raw_analysis, web_snippets)
        if auto_popup_content:
            popups.append({
                "titre": "ANALYSE & SOURCES WEB",
                "contenu": auto_popup_content
            })

    # 5. Optimisation de la formulation finale via l'architecture hybride (Groq pour la vitesse)
    final_answer = await _groq_finalize(prompt, answer)
    if final_answer:
        answer = final_answer

    # 6. Vérification finale par Fast Reasoning
    revised = await _groq_revise(prompt, answer, raw_analysis)
    if revised:
        answer = revised

    return {
        "reponse": answer,
        "memoire": memories,
        "popups": popups
    }
# --- Compatibilité TOTALE pour server.py ---
# On redéfinit les fonctions que server.py cherche ABSOLUMENT
async def generate_answer(prompt, history=None, profile=None, memory=None, mode="normal", keys=None, mood=None):
    return await ask_sirius(prompt, history, profile, memory, mode, keys, mood)

async def generate_answer_stream(prompt, history=None, profile=None, memory=None, mode="normal", keys=None, mood=None):
    # Streaming simulé vers ask_sirius
    res = await ask_sirius(prompt, history, profile, memory, mode, keys, mood)
    yield res.get("reponse", "")

# --- Alias de compatibilité et fonctions utilitaires pour server.py ---
async def generate_answer(prompt, history=None, profile=None, memory=None, mode="normal", keys=None, mood=None, ia_mode=None):
    return await ask_sirius(prompt, history, profile, memory, mode, keys, mood)

async def generate_answer_stream(prompt, history=None, profile=None, memory=None, mode="normal", keys=None, mood=None, ia_mode=None):
    res = await ask_sirius(prompt, history, profile, memory, mode, keys, mood)
    yield {
        "type": "done",
        "answer": res.get("reponse", ""),
        "memories": res.get("memoire", []),
        "popups": res.get("popups", [])
    }

