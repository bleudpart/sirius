async def _groq_popup(question, analysis, snippets):
    if not ENV_GROQ_LLM_KEY:
        return None
    client = AsyncOpenAI(api_key=ENV_GROQ_LLM_KEY, base_url=GROQ_LLM_ENDPOINT, max_retries=0, timeout=25.0)
    for model in (GROQ_LLM_MODEL, GROQ_LLM_FALLBACK):
        try:
            resp = await client.chat.completions.create(
                model=model,
                messages=[
                    {"role": "system", "content": POPUP_PROMPT},
                    {"role": "user", "content": f"QUESTION : {question}\n\nANALYSE INTERNE :\n{(analysis or '')[:2000]}\n\nEXTRAITS DE SOURCES :\n{(snippets or '')[:4000]}"},
                ],
                max_tokens=650,
            )
            out = (resp.choices[0].message.content or "").strip()
            if out:
                return out
        except Exception as e:
            logger.warning(f"[GROQ POPUP] {model}: {repr(e)}")
    return None


async def _groq_finalize(question, analysis):
    if not ENV_GROQ_LLM_KEY or not (analysis or "").strip():
        return None
    client = AsyncOpenAI(api_key=ENV_GROQ_LLM_KEY, base_url=GROQ_LLM_ENDPOINT, max_retries=0, timeout=25.0)
    import time as _t
    t0 = _t.time()
    for model in (GROQ_LLM_MODEL, GROQ_LLM_FALLBACK):
        try:
            resp = await client.chat.completions.create(
                model=model,
                messages=[
                    {"role": "system", "content": FINALIZE_PROMPT},
                    {"role": "user", "content": f"QUESTION UTILISATEUR : {question}\n\nANALYSE INTERNE :\n{analysis[:4000]}"},
                ],
                max_tokens=220,
            )
            out = (resp.choices[0].message.content or "").strip()
            if out:
                logger.info(f"[HYBRIDE] Groq formulation : {int((_t.time() - t0) * 1000)} ms ({model})")
                return out
        except Exception as e:
            logger.warning(f"[GROQ FORMULATION] {model}: {repr(e)}")
    return None


REVISE_PROMPT = (
    "Tu es le module Fast Reasoning de SIRIUS. On te donne la RÉPONSE INSTANTANÉE déjà affichée à l'utilisateur "
    "et une ANALYSE INTERNE plus profonde. Si l'analyse révèle une erreur factuelle ou un fait essentiel manquant, "
    "renvoie UNIQUEMENT la réponse corrigée/enrichie : claire, directe, technique, 3 phrases maximum, tutoiement "
    "(« tu », jamais « vous »), sans préambule, sans mentionner l'analyse ni aucun modèle. "
    "Si la réponse instantanée est déjà correcte et suffisante, renvoie EXACTEMENT le mot OK et rien d'autre."
)


async def _groq_revise(question, instant, analysis):
    if not ENV_GROQ_LLM_KEY or not (analysis or "").strip():
        return None
    client = AsyncOpenAI(api_key=ENV_GROQ_LLM_KEY, base_url=GROQ_LLM_ENDPOINT, max_retries=0, timeout=12.0)
    import time as _t
    t0 = _t.time()
    for model in (GROQ_LLM_MODEL, GROQ_LLM_FALLBACK):
        try:
            resp = await client.chat.completions.create(
                model=model,
                messages=[
                    {"role": "system", "content": REVISE_PROMPT},
                    {"role": "user", "content": f"QUESTION : {question}\n\nRÉPONSE INSTANTANÉE :\n{(instant or '')[:1500]}\n\nANALYSE INTERNE :\n{analysis[:4000]}"},
                ],
                max_tokens=220,
            )
            out = (resp.choices[0].message.content or "").strip()
            if not out or out.upper().rstrip(".!") == "OK":
                logger.info(f"[FAST REASONING] réponse instantanée validée ({int((_t.time() - t0) * 1000)} ms, {model})")
                return None
            logger.info(f"[FAST REASONING] réponse corrigée ({int((_t.time() - t0) * 1000)} ms, {model})")
            return out
        except Exception as e:
            logger.warning(f"[FAST REASONING] {model}: {repr(e)}")
    return None


