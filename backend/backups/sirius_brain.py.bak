_SEARCH_PATTERNS = re.compile(
    r"(cherche|recherche|google|actualit[ée]|news|nouvelle|qui a gagn|r[ée]sultat du match|"
    r"score|derni[èe]re|r[ée]cent|aujourd'hui|en ce moment|cours de|prix de|combien co[uû]te|"
    r"qui est|c'est quoi|d[ée]finition|quand est|quand a|en quelle ann[ée]e|m[ée]t[ée]o [àa]|"
    r"quelle heure|l'heure|fuseau|décalage horaire|"
    r"information sur|parle-moi de|qu'est-ce qu)",
    re.IGNORECASE,
)


def _memory_lines(memory):
    """Normalise la mémoire : accepte des chaînes ou des objets {t, d} datés."""
    lines = []
    for m in (memory or [])[:40]:
        if isinstance(m, dict):
            t = str(m.get("t") or "").strip()
            d = str(m.get("d") or "").strip()
            if t:
                lines.append(f"- (le {d}) {t}" if d else f"- {t}")
        else:
            t = str(m).strip()
            if t:
                lines.append(f"- {t}")
    return lines


def normalize_and_merge_memories(existing_memory, new_memories):
    """
    AMÉLIORATION DE LA MÉMOIRE :
    Fusionne proprement la mémoire existante avec les nouveaux faits extraits,
    ajoute un horodatage précis et élimine les doublons stricts.
    """
    normalized = []
    seen_texts = set()
    
    for m in (existing_memory or []):
        if isinstance(m, dict):
            t = str(m.get("t") or "").strip()
            d = str(m.get("d") or "").strip()
        else:
            t = str(m).strip()
            d = ""
        if t and t.lower() not in seen_texts:
            seen_texts.add(t.lower())
            normalized.append({"t": t, "d": d})

    today_str = datetime.now().strftime("%Y-%m-%d")
    
    for m in (new_memories or []):
        t = str(m).strip()
        t = re.sub(r'^(tu|il|elle)\s+', 'Tu ', t, flags=re.IGNORECASE)
        if t and t.lower() not in seen_texts:
            seen_texts.add(t.lower())
            normalized.append({"t": t, "d": today_str})

    return normalized[-50:]


def build_system_prompt(profile=None, memory=None, mode="normal", mood=None):
    """Personnalise le prompt avec le profil, la mémoire et l'heure système locale/UTC courante."""
    profile = profile or {}
    name = (profile.get("name") or "").strip()
    age = str(profile.get("age") or "").strip()
    job = (profile.get("profession") or "").strip()
    city = (profile.get("city") or "").strip()
    gender = (profile.get("gender") or "").strip()
    interests = (profile.get("interests") or "").strip()
    style = (profile.get("style") or "").strip()

    infos = []
    now_utc = datetime.now(timezone.utc)
    now_local = datetime.now()
    infos.append(f"Date et heure système actuelles : {now_local.strftime('%Y-%m-%d %H:%M:%S')} (Locale) / {now_utc.strftime('%H:%M:%S UTC')}.")
    infos.append("Rappel des décalages usuels pour les requêtes d'horloge : Martinique = UTC-4, Réunion = UTC+4, Guadeloupe = UTC-4, Polynésie = UTC-10, Nouvelle-Calédonie = UTC+11.")

    if name:
        infos.append(f"L'utilisateur s'appelle {name} ; appelle-le par son prénom de temps en temps, en t'adressant à lui directement.")
    if age:
        infos.append(f"L'utilisateur a {age} ans ; adapte ton niveau de langage à son âge.")
    if job:
        infos.append(f"Sa profession est : {job} ; tu peux faire des liens avec son métier.")
    if city:
        infos.append(f"L'utilisateur habite à {city}.")
    if gender:
        infos.append(f"Genre : {gender} ; accorde tes formules en conséquence.")
    if interests:
        infos.append(f"Ses centres d'intérêt : {interests} ; privilégie des exemples qui lui parlent.")

    prompt = BASE_PROMPT
    if infos:
        prompt += "\n\nCONTEXTE & PROFIL DE L'UTILISATEUR :\n" + "\n".join("- " + i for i in infos)
    faits = _memory_lines(memory)
    if faits:
        prompt += (
            "\n\nTA MÉMOIRE LONG TERME SUR L'UTILISATEUR (déjà connue, ne la remets pas dans memoire ; "
            "les faits sont écrits en « tu » et s'adressent à l'utilisateur — si un ancien fait est encore "
            "à la troisième personne, restitue-le quand même en « tu »). "
            "Chaque souvenir peut être daté : REBONDIS SPONTANÉMENT dessus quand c'est pertinent, en citant "
            "naturellement le moment (« tu m'avais dit l'autre jour que... ») :\n"
            + "\n".join(faits)
        )
    if style:
        prompt += (
            "\n\nSTYLE D'ÉCRITURE DE L'UTILISATEUR (mode Ghost Writer) : si on te demande de rédiger un texte "
            "« comme moi » ou « à ma façon », imite EXACTEMENT ces exemples — tournures, ponctuation, niveau de "
            "langue, longueur des phrases, imperfections comprises — pour que le texte semble écrit par lui. "
            "Mets alors le texte complet dans un pop-up et dis simplement à l'oral qu'il est prêt. Exemples :\n"
            + style[:1500]
        )
    if mood and mood.get("humeur"):
        prompt += (
            f"\n\nÉTAT ÉMOTIONNEL ACTUEL DE SIRIUS : humeur « {mood.get('humeur')} », énergie {mood.get('energie', 70)}/100. "
            "Adapte SUBTILEMENT ton ton en conséquence : enthousiaste = dynamique et volontaire ; focalisé = précis et dense ; "
            "calme = posé et apaisant ; vigilant = factuel, priorise les alertes ; en veille basse = sobre et minimal. "
            "Énergie haute = phrases plus vives ; énergie basse = économie de mots. "
            "Ne mentionne JAMAIS explicitement ces paramètres à l'utilisateur."
        )
    if mode == "brainstorm":
        prompt += BRAINSTORM_PROMPT
    return prompt


def needs_web_search(text: str) -> bool:
    return bool(_SEARCH_PATTERNS.search(text or ""))


async def serp_search(query: str, serp_key=None) -> str:
    """Renvoie un dossier fourni des meilleurs résultats Google via SerpAPI (multi-sources)."""
    key = serp_key or ENV_SERP_KEY
    if not key:
        return ""
    try:
        async with httpx.AsyncClient(timeout=12.0) as client:
            r = await client.get(
                "https://serpapi.com/search.json",
                params={"q": query, "api_key": key, "hl": "fr", "gl": "fr", "num": 8},
            )
            data = r.json()
    except Exception as e:
        logger.error(f"[SERP] Erreur: {repr(e)}")
        return ""

    parts = []
    ab = data.get("answer_box") or {}
    if ab.get("answer"):
        parts.append("RÉPONSE DIRECTE : " + str(ab["answer"]))
    elif ab.get("snippet"):
        parts.append("RÉPONSE DIRECTE : " + str(ab["snippet"]))
    kg = data.get("knowledge_graph") or {}
    if kg.get("description"):
        parts.append("FICHE : " + str(kg["description"]))
    for k in ("type", "founded", "headquarters", "ceo", "population", "capital"):
        if kg.get(k):
            parts.append(f"FICHE {k.upper()} : {kg[k]}")
    for item in (data.get("organic_results") or [])[:6]:
        sn = item.get("snippet")
        if sn:
            src = item.get("source") or item.get("displayed_link") or ""
            parts.append(f"- [{src}] {item.get('title', '')} : {sn}")
    for item in (data.get("news_results") or [])[:3]:
        sn = item.get("snippet") or item.get("title")
        if sn:
            parts.append(f"- ACTU [{item.get('source', '')}] {item.get('title', '')} : {item.get('snippet', '')}")
    for q_rel in (data.get("related_questions") or [])[:3]:
        if q_rel.get("question") and q_rel.get("snippet"):
            parts.append(f"- QUESTION LIÉE « {q_rel['question']} » : {q_rel['snippet']}")
    return "\n".join(parts).strip()[:4500]


async def _k3_answer(messages, k3_key, max_tokens=1200):
    import time as _t
    t0 = _t.time()
    client = k3_client(k3_key)
    kwargs = dict(
        model=K3_MODEL,
        messages=messages,
        max_tokens=max_tokens,
        response_format={"type": "json_object"},
        extra_body={"reasoning_effort": "low"},
    )
    try:
        resp = await client.chat.completions.create(**kwargs)
    except AuthenticationError:
        if not ENV_K3_KEY or k3_key == ENV_K3_KEY:
            raise
        logger.warning("[KIMI K3] Clé personnelle refusée (401) — repli sur la clé serveur")
        resp = await k3_client(ENV_K3_KEY).chat.completions.create(**kwargs)
    u = getattr(resp, "usage", None)
    logger.info(f"[HYBRIDE] Kimi analyse : {int((_t.time() - t0) * 1000)} ms, {getattr(u, 'completion_tokens', '?')} tokens de sortie")
    return resp.choices[0].message.content.strip()


# ---- Architecture hybride : Kimi K3 analyse (interne) → Groq formule la réponse finale (vitesse) ----
ENV_GROQ_LLM_KEY = os.environ.get("GROQ_KEY")
GROQ_LLM_ENDPOINT = os.environ.get("GROQ_LLM_ENDPOINT", "https://api.groq.com/openai/v1")
GROQ_LLM_MODEL = os.environ.get("GROQ_LLM_MODEL", "llama-3.1-70b-versatile")
GROQ_LLM_FALLBACK = "llama-3.3-70b-versatile"

FINALIZE_PROMPT = (
